<?xml version="1.0"?>
<ruleset name="MetCPT">
    <description>WordPress Coding Standards for this plugin.</description>

    <file>.</file>

    <!-- Third-party and generated code is not ours to lint. -->
    <exclude-pattern>/libs/*</exclude-pattern>
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/build/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <config name="minimum_wp_version" value="6.0"/>
    <config name="testVersion" value="7.4-"/>

    <rule ref="WordPress"/>
    <rule ref="PHPCompatibilityWP"/>

    <!-- Every string must use the plugin text domain. -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array" value="metcpt"/>
        </properties>
    </rule>

    <!-- Everything global must carry the plugin prefix. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="metcpt"/>
                <element value="METCPT"/>
                <element value="MetCPT"/>
            </property>
        </properties>
    </rule>
</ruleset>
