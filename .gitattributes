# MetCPT — line ending normalization
#
# Normalizes all text files to LF in the repository so that diffs stay clean
# and the live server stops accumulating doubled carriage returns. Binary
# files are marked explicitly so git never alters them.

# Default: treat everything as text and normalize to LF on commit.
* text=auto eol=lf

# Source and content files — force LF.
*.php  text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.yml  text eol=lf
*.po   text eol=lf
*.pot  text eol=lf

# Development-only files — kept in the repo, excluded from `git archive`
# output. release.yml builds the zip with its own copy+exclude step (not
# git archive), so its exclude list must be kept in sync with this one.
DOCS/               export-ignore
PLAN/               export-ignore
CLAUDE.md           export-ignore
PROJECT_AUDIT_AND_CONTEXT.md export-ignore
composer.json       export-ignore
composer.lock       export-ignore
phpcs.xml.dist      export-ignore
.editorconfig       export-ignore
.gitattributes       export-ignore
.gitignore           export-ignore

# Binary files — never normalize, never diff as text.
*.mo    binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.zip   binary